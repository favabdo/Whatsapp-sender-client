# Runtime only — do not ignore the API/UI binaries (clients need them).
# electron.exe alone exceeds GitHub's 100MB limit, so install via npm after clone/update.

node_modules/
uploads/
wa_chrome_profile/
_update_tmp/
output.log
update.log
UPDATE_FAILED.txt
*.zip
# PyInstaller freezes the stdlib into _internal/base_library.zip - the API cannot start without it
!_internal/**/*.zip
.DS_Store
Thumbs.db

# Keep encryption key; ignore local SQL settings per machine
secure/*
!secure/users.key
